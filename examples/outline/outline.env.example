NODE_ENV=production
URL=https://docs.example.com
PORT=3000
SECRET_KEY=            # openssl rand -hex 32
UTILS_SECRET=          # openssl rand -hex 32
DATABASE_URL=postgres://outline:PASSWORD@host.docker.internal:5432/outline
PGSSLMODE=disable
REDIS_URL=redis://redis:6379
FILE_STORAGE=local
FILE_STORAGE_LOCAL_ROOT_DIR=/var/lib/outline/data
FORCE_HTTPS=false      # TLS ends at your proxy
OIDC_CLIENT_ID=outline
OIDC_CLIENT_SECRET=    # the same value as in dex.yaml
OIDC_AUTH_URI=https://login.example.com/dex/auth
OIDC_TOKEN_URI=https://login.example.com/dex/token
OIDC_USERINFO_URI=https://login.example.com/dex/userinfo
OIDC_USERNAME_CLAIM=preferred_username
OIDC_DISPLAY_NAME=Sign in
OIDC_SCOPES=openid profile email
# Outline will not post webhooks to private addresses unless they are listed here. When margin
# runs on the Docker host, this is the host gateway address as seen from the container.
ALLOWED_PRIVATE_IP_ADDRESSES=192.168.5.2
